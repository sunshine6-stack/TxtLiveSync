<Window x:Class="TxtLiveSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TxtLiveSync"
        Icon="pack://application:,,,/app.ico"
        Width="1040" Height="700" MinWidth="560" MinHeight="360"
        Background="#FFFFFF"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragOver="OnDragOver" PreviewDragLeave="OnDragLeave" PreviewDrop="OnDrop"
        Loaded="OnLoaded" Closing="OnClosing">

  <Window.Resources>

    <!-- 标签页：灰底上的白色卡片，选中带蓝色下划线 -->
    <Style x:Key="DocTabItem" TargetType="TabItem">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid>
              <Border x:Name="b" Background="Transparent" CornerRadius="6,6,0,0"
                      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
              </Border>
              <Border x:Name="accent" Height="2" VerticalAlignment="Bottom" Margin="10,0,10,0"
                      Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E4E8ED" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFFFFF" />
                <Setter TargetName="accent" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 标签条：单行横向滚动，多了不换行挤压正文 -->
    <Style x:Key="DocTabControl" TargetType="TabControl">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource DocTabItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="#F1F3F6" Padding="8,5,8,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                  <TabPanel IsItemsHost="True" />
                </ScrollViewer>
              </Border>

              <Border Grid.Row="1" Background="#FFFFFF">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶栏：一行装下菜单与常用动作，不再分两列 -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1">
      <DockPanel Height="38" LastChildFill="True" Margin="7,0,7,0">

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="BtnOpen"
                  Click="OnOpen" ToolTip="打开文件（Ctrl+O，可多选）">
            <Path Data="{StaticResource IconOpen}" Fill="Transparent" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="BtnSave"
                  Click="OnSave" ToolTip="保存当前标签（Ctrl+S）">
            <Path Data="{StaticResource IconSave}" Fill="Transparent" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="BtnReload"
                  Click="OnReload" ToolTip="丢弃未保存内容，从磁盘重读（F5）">
            <Path Data="{StaticResource IconReload}" Fill="Transparent" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>

          <Border Width="1" Height="16" Margin="7,0" VerticalAlignment="Center"
                  Background="{StaticResource LineBrush}" />

          <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="BtnFind"
                  Click="OnFind" ToolTip="在当前文件里查找（Ctrl+F）">
            <Path Data="{StaticResource IconFind}" Fill="Transparent" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>

          <Border Width="1" Height="16" Margin="7,0" VerticalAlignment="Center"
                  Background="{StaticResource LineBrush}" />

          <Button Style="{StaticResource IconButton}" AutomationProperties.AutomationId="BtnCloseTab"
                  Click="OnCloseTab" ToolTip="关闭当前标签（Ctrl+W）">
            <Path Data="{StaticResource IconClose}" Fill="Transparent" StrokeThickness="1.2"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>

        <Menu DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Padding="0"
              VerticalAlignment="Center">
          <Menu.ItemContainerStyle>
            <Style TargetType="MenuItem" BasedOn="{StaticResource MenuTop}" />
          </Menu.ItemContainerStyle>

          <MenuItem Header="文件">
            <MenuItem Header="打开…" Click="OnOpen" InputGestureText="Ctrl+O" />
            <MenuItem Header="保存" Click="OnSave" InputGestureText="Ctrl+S" />
            <MenuItem Header="另存为…" Click="OnSaveAs" InputGestureText="Ctrl+Shift+S" />
            <Separator />
            <MenuItem Header="从磁盘重新加载" Click="OnReload" InputGestureText="F5" />
            <MenuItem Header="关闭当前标签" Click="OnCloseTab" InputGestureText="Ctrl+W" />
            <Separator />
            <MenuItem Header="退出" Click="OnExit" />
          </MenuItem>

          <MenuItem Header="编辑">
            <MenuItem Header="查找…" Click="OnFind" InputGestureText="Ctrl+F" />
            <MenuItem Header="替换…" Click="OnReplace" InputGestureText="Ctrl+H" />
            <MenuItem Header="查找下一个" Click="OnFindNext" InputGestureText="F3" />
            <Separator />
            <MenuItem Header="跳到当前行行尾" Click="OnJumpLineEnd" InputGestureText="End" />
            <MenuItem Header="跳到全文最后" Click="OnJumpDocumentEnd" InputGestureText="Ctrl+End" />
          </MenuItem>

          <MenuItem Header="视图">
            <MenuItem x:Name="WrapItem" Header="自动换行" IsCheckable="True"
                      Checked="OnWrapChanged" Unchecked="OnWrapChanged" />
            <Separator />
            <MenuItem Header="增大字号" Click="OnFontBigger" InputGestureText="Ctrl+=" />
            <MenuItem Header="减小字号" Click="OnFontSmaller" InputGestureText="Ctrl+-" />
          </MenuItem>

          <MenuItem Header="设置">
            <MenuItem x:Name="SingleInstanceItem" Header="双击文件时用已开的窗口打开" IsCheckable="True"
                      Click="OnSingleInstanceToggle"
                      ToolTip="开启后，双击 .txt 会把文件送进正在运行的窗口（已在标签里就切过去），不再新开一个程序。" />
            <Separator />
            <MenuItem x:Name="ConfirmItem" Header="外部变更时弹窗确认" IsCheckable="True"
                      Click="OnConfirmToggle" />
          </MenuItem>

          <MenuItem Header="帮助">
            <MenuItem Header="关于" Click="OnAbout" />
          </MenuItem>
        </Menu>

      </DockPanel>
    </Border>

    <!-- 标签页 + 正文 -->
    <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource DocTabControl}"
                SelectionChanged="OnTabSelectionChanged" />

    <!-- 没有标签时的引导 -->
    <Border x:Name="EmptyHint" Grid.Row="1" Background="#FFFFFF">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="没有打开的文件" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center" />
        <TextBlock Text="把 .txt 拖进来，或点下面的按钮" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="打开文件…" Click="OnOpen"
                Margin="0,18,0,0" HorizontalAlignment="Center" />
        <TextBlock Text="Ctrl+F 查找 · Ctrl+W 关标签 · Ctrl+Tab 切换"
                   FontSize="11" Foreground="#A0A7B1" HorizontalAlignment="Center" Margin="0,20,0,0" />
      </StackPanel>
    </Border>

    <!-- 状态栏 -->
    <Border Grid.Row="2" Background="{StaticResource ChromeBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <!-- 右侧信息块：后声明的先靠左，所以 MetaText（编码等）在最右，光标位置排在它左边 -->
        <TextBlock x:Name="MetaText" DockPanel.Dock="Right" Text=""
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
        <!-- 光标位置：右对齐 + 固定最小宽度，数字位数变化时右边的编码信息不会左右跳 -->
        <TextBlock x:Name="CaretText" DockPanel.Dock="Right" Text="" MinWidth="100"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   TextAlignment="Right"
                   VerticalAlignment="Center" Margin="0,0,4,0" />
        <Border DockPanel.Dock="Right" Width="1" Height="10" Margin="0,0,10,0"
                Background="{StaticResource LineBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="就绪"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 拖入提示层：不参与命中测试，避免挡住真正的拖放目标 -->
    <Border x:Name="DropOverlay" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
            BorderThickness="3" BorderBrush="{StaticResource AccentBrush}" Background="#E6FFFFFF">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="#FFFFFF" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
              CornerRadius="10" Padding="26,16">
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.14" />
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DropOverlayText" Text="松开以打开该文件"
                     FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="DropOverlaySub" Text="拖入单个文件即可"
                     FontSize="11" Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
