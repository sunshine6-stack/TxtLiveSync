<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- 主目标是 .NET Framework 4.8：Win10 1903+ / Win11 上它是系统组件，用户不用装任何运行时。
         .NET 8 目标保留，给需要单文件/较新运行时的场合。
         代码必须两边都能编 —— 所以只用两代都有的 API（缺的用 Core\Compat.cs 补）。 -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>TxtLiveSync</AssemblyName>
    <RootNamespace>TxtLiveSync</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>TxtLiveSync</AssemblyTitle>
    <Product>TxtLiveSync — TXT 实时同步编辑器</Product>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PublishTrimmed>false</PublishTrimmed>   <!-- WPF 不支持裁剪，别开 -->
  </PropertyGroup>

  <!-- .NET Framework 4.8：产物就是单个 exe（外加可选的 exe.config），没有单文件/自包含概念 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- .NET 8：单文件、框架依赖；RollForward 让装 8/9/10 任一桌面运行时都能启动 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RollForward>LatestMajor</RollForward>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
